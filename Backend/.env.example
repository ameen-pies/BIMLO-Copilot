# BIMLO Copilot Backend Configuration
# Copy this file to .env and fill in your values
#
# ⚠️  PRODUCTION SECURITY: For any environment exposed to the internet,
#     do NOT use .env with plaintext secrets. Instead, use a secrets manager:
#       doppler setup --project bimlo-copilot --config prd
#       doppler run -- python main.py
#     This injects secrets as env vars at runtime without ever writing
#     them to disk. (See Dockerfile and docker-compose.yml for details.)

# Groq API Key for LLM
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Vector Store Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Model Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
LLM_MODEL=llama-3.3-70b-versatile

# Cloudflare Workers AI
CF_API_KEY=your_cf_api_key_here
CF_API_URL=https://your-worker.workers.dev
CF_BACKUP_URL=https://your-backup-worker.workers.dev/
CF_BACKUP_API_KEY=your_cf_backup_api_key_here

# ElevenLabs (voice)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Firecrawl
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here

# SMTP (email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM=your_email@gmail.com

# Nvidia
NVIDIA_API_KEY=your_nvidia_api_key_here

# CORS: Comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Upload: Max file size in MB
MAX_UPLOAD_MB=50
